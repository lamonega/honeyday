# Auto-detect text files and normalize line endings
* text=auto

# Dart source
*.dart text diff=dart

# Mark generated code as linguist-generated
*.g.dart linguist-generated=true
*.drift.dart linguist-generated=true
*.freezed.dart linguist-generated=true
*.mocks.dart linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Preserve upstream font licenses verbatim and keep checksums reproducible.
assets/fonts/OFL-*.txt text eol=lf whitespace=-blank-at-eol
assets/fonts/LICENSE-*.txt text eol=lf whitespace=-blank-at-eol

# Other
*.md text diff=markdown
*.yaml text
*.json text
*.lock text
