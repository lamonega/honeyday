# ==========================================
# Flutter / Dart / Pub
# ==========================================
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Obfuscation & Symbols
app.*.symbols
app.*.map.json

# Tooling & Widget Preview
.widget_preview/

# Golden tests failure artifacts (transient debugging diffs)
test/**/failures/

# pubspec.lock MUST be tracked for applications (ensures reproducible builds)
!pubspec.lock

# ==========================================
# Code Generation (build_runner / Drift / Freezed)
# ==========================================
